{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/H4ckD4d/digipass/schemas/remediation.schema.json",
  "title": "h4ckd4d Digital Safety Intelligence Remediation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "plan_id",
    "assessment_id",
    "scope_mode",
    "created_at",
    "items"
  ],
  "properties": {
    "version": {"const": "1.0"},
    "plan_id": {"type": "string", "pattern": "^H4D-DSI-REM-[A-Z0-9-]+$"},
    "assessment_id": {"type": "string", "minLength": 1},
    "scope_mode": {"enum": ["self", "consensual-family"]},
    "created_at": {"type": "string", "format": "date-time"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "category",
          "original_score",
          "control_id",
          "control",
          "verification_step",
          "status",
          "target_date",
          "verified_at"
        ],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^DSI-F-[A-Z0-9-]+$"},
          "category": {
            "enum": [
              "account-security",
              "privacy-exposure",
              "recovery",
              "location-sharing",
              "unwanted-contact",
              "device-security",
              "data-sharing",
              "family-safety"
            ]
          },
          "original_score": {"type": "integer", "minimum": 0, "maximum": 100},
          "control_id": {"type": "string", "pattern": "^DSI-CTRL-[A-Z0-9-]+$"},
          "control": {"type": "string", "minLength": 1},
          "verification_step": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "open",
              "in-progress",
              "ready-for-verification",
              "verified",
              "deferred",
              "not-applicable"
            ]
          },
          "target_date": {
            "oneOf": [
              {"type": "string", "format": "date"},
              {"type": "null"}
            ]
          },
          "verified_at": {
            "oneOf": [
              {"type": "string", "format": "date-time"},
              {"type": "null"}
            ]
          }
        }
      }
    }
  },
  "x-project-owner": "Chris Cruz | h4ckd4d"
}
