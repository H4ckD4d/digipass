{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://crisistrust.example/schemas/community-resource.schema.json",
  "title": "CrisisTrust Community Resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type", "protocol_version", "resource_id", "resource_type", "name",
    "area_description", "source", "verification_status", "availability"
  ],
  "properties": {
    "record_type": {"const": "community-resource"},
    "protocol_version": {"const": "0.1"},
    "resource_id": {"type": "string", "minLength": 3},
    "resource_type": {
      "enum": ["shelter", "cooling-center", "water", "charging", "medical", "information-point", "other"]
    },
    "name": {"type": "string", "minLength": 1},
    "area_description": {"type": "string", "minLength": 1},
    "address": {"type": "string"},
    "source": {"type": "string", "minLength": 1},
    "verification_status": {"enum": ["verified", "stale", "unverified"]},
    "last_verified_at": {"type": "string", "format": "date-time"},
    "availability": {"enum": ["available", "limited", "unavailable", "unknown"]},
    "availability_note": {"type": "string", "maxLength": 300},
    "accessibility_note": {"type": "string", "maxLength": 300}
  }
}
